/* Global Styling */
html {
  background-image: url("/images/ii2leredrp691.jpg");
  background-repeat: no-repeat;
  background-size: cover;
  font: 22px "Courier New", Courier, monospace;
  color: #313131;
  height: 100%
}

h1 {
  font-size: 2em;
  grid-column: 1 / -1;
  margin: 0;
  text-align: center;
}

ul {
  list-style-type: none;
}

a {
  color: inherit;
  text-decoration: none;
}

a:focus,
a:hover {
  color: goldenrod;
}

/* Div Styling */
#grid-container {
  display: grid;
  align-items: center;
  justify-content: center;
  grid-template-rows: 1fr 1fr 1fr 1fr;
  grid-template-columns: 1fr 1fr 1fr 1fr;
}

#bookmark-tab-container {
  grid-row-start: 1;
  grid-column-start: 2;
  grid-column-end: 4;
  column-span: 2;
  display: flex;
  flex-direction: row;
  border: 2px solid #313131;
  background-color: white;
  margin-top: 4em;
}

#bookmark-tab-container > img {
  border: 2px solid #313131;
  object-fit: cover;
  object-position: 50% 100%;
  margin-top: 1em;
  margin-right: 1em;
}

#bookmark-nav {
  display: grid;
  grid-row-gap: 1em;
  grid-template-columns: 1fr 1fr;
  margin: 0 1em;
  min-width: 24em;
  padding: 1em 0;
}

#weather-container {
  grid-row-start: 2;
  grid-column-start: 2;
  grid-column-end: 3;
  display: flex;
  background-color: white;
  border: 2px solid #313131;
  margin-top: -4em;
  margin-bottom: 5em;
  width: 12.5em;
}

#weather-widget {
  display: grid;
  grid-template-rows: 0.25fr 1fr;
}

#weather-widget > h2 {
  margin-top: 1em;
  text-align: center;
  padding-top: 0em;
}

#weather-widget-day-container {
  display: flex;
  flex-direction: row;
  padding-left: 1.5em;
  padding-bottom: 1em;
}

.weather-widget-day {
  background-color: white;
  width: 154px;
  border: 2px solid #313131;
  text-align: center;
  padding-left: 0.25em;
  padding-right: 0.25em;
  margin-left: 1em;
  margin-right: 0.25em;
}

.weather-widget-day > img {
 width: 50px;
 height: 50px;
}

.weather-widget-day > h3 {
  margin-top: 0.1em;
  margin-bottom: 0.1em;
}

.weather-widget-day > p {
  margin-top: 0.01em;
  margin-bottom: 0.1em;
}