<div class="service-card">
  <div class="service-card-top">
    <div class="service-icon">
    <img src= "<%= services.portainer.icon %>"/>
    </div>
    <a class="service-link" href="<%= services.portainer.url %>" target="_blank">
      <h2 class="service-name"><%= services.portainer.name %></h2>
    </a>
    <div class="service-online-indicator-circle"></div>
  </div>
  <div class="service-card-middle">
    <p class="service-description"> <%=services.portainer.description %> </p>
  </div>
  <div class="service-card-bottom">
    <p class="service-info-bar"> <%= services.portainer.containerType %> </p>
    <p class="service-port-number"><b> <%= services.portainer.port %> </b></p>
    <a class="compose-link" href="http://zimaos.shorthair-artichoke.ts.net:7681/" target="_blank">
      <img src="icons/docker-icon.png"/>
    </a> 
    <a class="terminal-link" href="http://zimaos.shorthair-artichoke.ts.net:7681/" target="_blank">
      <img src="icons/terminal-icon.png"/>
    </a>
  </div>
</div>
