<div class="service-card">
  <div class="service-card-top">
    <div class="service-icon">
    <img src= "<%= services.jellyfin.icon %>"/>
    </div>
    <a class="service-link" href=" <%= services.jellyfin.url %>" target="_blank">
      <h2 class="service-name"><%= services.jellyfin.name %></h2>
    </a>
    <div class="service-online-indicator-circle"></div>
  </div>
  <div class="service-card-middle">
    <p class="service-description"> <%=services.jellyfin.description %> </p>
  </div>
  <div class="service-card-bottom">
    <p class="service-info-bar"> <%= services.jellyfin.containerType %> </p>
    <p class="service-port-number"><b> <%= services.jellyfin.port %> </b></p>
    <a class="compose-link" href="http://192.168.68.51:7681/" target="_blank">
      <img src="icons/docker-icon.png"/>
    </a> 
    <a class="terminal-link" href="http://192.168.68.51:7681/" target="_blank">
      <img src="icons/terminal-icon.png"/>
    </a>
  </div>
</div>
