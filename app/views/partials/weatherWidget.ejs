<div id="weather-container">
  <div id="weather-widget">
    <h2> <%=currWeatherData.city%></h2>
    <div id="weather-widget-day-container">
      <div class="weather-widget-day">
        <h3>Today</h3>
        <p><b> <%=currWeatherData.currTemp%> </b></p>
        <img src="https://openweathermap.org/img/wn/<%=currWeatherData.currIcon%>@2x.png"/> 
        <p> <%=currWeatherData.currMinTemp%>|<%=currWeatherData.currMaxTemp %> </p>
      </div>
    </div>
  </div>
</div>