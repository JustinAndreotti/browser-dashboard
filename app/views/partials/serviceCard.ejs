<div class="service-card">
  <div class="service-card-top">
    <div class="service-icon">
    <img src= "<%=service.icon %>"/>
    </div>
    <a class="service-link" href="<%=service.url %>" target="_blank">
      <h2 class="service-name"><%=service.name %></h2>
    </a>
    <div class="service-online-indicator-circle"></div>
  </div>
  <div class="service-card-middle">
    <p class="service-description"> <%=service.description %> </p>
  </div>
  <div class="service-card-bottom">
    <p class="service-info-bar"> <%=service.containerType %> </p>
    <p class="service-port-number"><b> <%=service.port %> </b></p>
    <a open-modal class="compose-modal" 
      href="#compose-dialog-container" 
      data-service-key="<%= service.key %>"
      data-service-name="<%= service.name %>" >
      <img src="icons/docker-icon.png"/>
    </a> 
    <a class="terminal-modal" 
      href="#terminal-dialog-container"
      data-service-key="<%= service.key %>"
      data-service-name="<%= service.name %>">
      <img src="icons/terminal-icon.png"/>
    </a>
  </div>
</div>
