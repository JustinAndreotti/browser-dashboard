<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles/global.css" />
  <link rel="stylesheet" href="/styles/dashboard.css" />
  <link rel="stylesheet" href="/styles/dashboard-service-card.css" />
  <title>Pastry Dashboard</title>
</head>
<body>
  <div id="home-button">
    <a href="http://zimaos.shorthair-artichoke.ts.net:8085/">
      <img id="home-icon" src="icons/home-icon.png"/>
    </a>
  </div>
  <div id="dashboard-flex-container">
    <div id="dashboard-grid-container">
      <div id=admin-apps>
        <%- include("partials/serviceCard", {service: services.zimaos}) %>
        <%- include("partials/serviceCard", {service: services.fileBrowser}) %>
        <%- include("partials/serviceCard", {service: services.serverTerminal}) %>
        <%- include("partials/serviceCard", {service: services.portainer}) %>
      </div>

      <div id="media-apps">
        <%- include("partials/serviceCard", {service: services.jellyfin}) %>
        <%- include("partials/serviceCard", {service: services.qbittorrent}) %>
        <%- include("partials/serviceCard", {service: services.sonarr}) %>
        <%- include("partials/serviceCard", {service: services.radarr}) %>
        <%- include("partials/serviceCard", {service: services.prowlarr}) %>
        <%- include("partials/serviceCard", {service: services.clonarr}) %>
      </div>

      <div id="other-apps">
        <%- include("partials/serviceCard", {service: services.uptimeKuma}) %>
        <%- include("partials/serviceCard", {service: services.immich}) %>
        <%- include("partials/serviceCard", {service: services.customDashboard}) %>
      </div>

      <div id=game-server-apps>
        <%- include("partials/serviceCard", {service: services.crafty}) %>
        <%- include("partials/serviceCard", {service: services.playit}) %>
        <%- include("partials/serviceCard", {service: services.omegga}) %>
      </div>

      <div id="vpn-apps">
        <%- include("partials/serviceCard", {service: services.tailscale}) %>
        <%- include("partials/serviceCard", {service: services.mullvad}) %>
      </div>

    </div>
  </div>
</body>
</html>